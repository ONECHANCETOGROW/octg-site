{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Opportunities Schema",
    "description": "Output format for Module 5 Opportunity Engine",
    "type": "object",
    "required": ["metadata", "opportunities"],
    "properties": {
        "metadata": {
            "type": "object"
        },
        "opportunities": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["opportunity_id", "rule_id", "problem", "evidence", "business_impact", "estimated_roi", "priority", "difficulty"],
                "properties": {
                    "opportunity_id": { "type": "string" },
                    "rule_id": { "type": "string" },
                    "problem": { "type": "string" },
                    "evidence": { "type": "object" },
                    "business_impact": { "type": "string" },
                    "estimated_roi": { "type": "string" },
                    "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
                    "difficulty": { "type": "string", "enum": ["Hard", "Medium", "Easy"] }
                }
            }
        }
    }
}
