{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Rule Results Schema",
    "description": "Output format for Module 3 Rule Engine",
    "type": "object",
    "required": ["metadata", "triggered_rules", "passed_rules", "validation_summary"],
    "properties": {
        "metadata": {
            "type": "object",
            "required": ["contract_version", "engine_version", "plugin", "generated_at"],
            "properties": {
                "contract_version": { "type": "string" },
                "engine_version": { "type": "string" },
                "plugin": { "type": "string" },
                "plugin_version": { "type": "string" },
                "generated_at": { "type": "string", "format": "date-time" }
            }
        },
        "triggered_rules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["rule_id", "severity", "category", "evidence", "status", "score_weight"],
                "properties": {
                    "rule_id": { "type": "string" },
                    "severity": { "type": "string" },
                    "category": { "type": "string" },
                    "evidence": { "type": "object", "additionalProperties": true },
                    "status": { "type": "string", "enum": ["FAIL", "WARNING"] },
                    "score_weight": { "type": "number" }
                }
            }
        },
        "passed_rules": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "validation_summary": {
            "type": "object",
            "properties": {
                "total_rules_evaluated": { "type": "integer" },
                "total_triggered": { "type": "integer" },
                "total_passed": { "type": "integer" },
                "errors": { "type": "array", "items": { "type": "string" } }
            }
        }
    }
}
