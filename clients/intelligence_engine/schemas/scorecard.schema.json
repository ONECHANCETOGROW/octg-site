{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Scorecard Schema",
    "description": "Output format for Module 4 Scoring Engine",
    "type": "object",
    "required": ["metadata", "overall_score", "health_status", "grade", "categories", "penalties"],
    "properties": {
        "metadata": {
            "type": "object"
        },
        "overall_score": {
            "type": "number"
        },
        "health_status": {
            "type": "string",
            "enum": ["Excellent", "Good", "Fair", "Poor", "Critical"]
        },
        "grade": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "F"]
        },
        "categories": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "required": ["score", "grade", "penalties_applied"],
                "properties": {
                    "score": { "type": "number" },
                    "grade": { "type": "string" },
                    "penalties_applied": { "type": "number" }
                }
            }
        },
        "penalties": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["rule_id", "category", "penalty", "evidence"],
                "properties": {
                    "rule_id": { "type": "string" },
                    "category": { "type": "string" },
                    "penalty": { "type": "number" },
                    "evidence": { "type": "object" }
                }
            }
        }
    }
}
