{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Executive Summary Schema",
    "description": "Output format for Module 7 Executive Summary Engine",
    "type": "object",
    "required": ["metadata", "executive_summary", "biggest_wins", "biggest_risks", "immediate_actions", "long_term_strategy", "overall_business_assessment"],
    "properties": {
        "metadata": { "type": "object" },
        "executive_summary": { "type": "string" },
        "biggest_wins": { "type": "array", "items": { "type": "string" } },
        "biggest_risks": { "type": "array", "items": { "type": "string" } },
        "immediate_actions": { "type": "array", "items": { "type": "string" } },
        "long_term_strategy": { "type": "string" },
        "overall_business_assessment": { "type": "string" }
    }
}
